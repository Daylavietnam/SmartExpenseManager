<resources>
    <color name="ui_primary">#087F72</color>
    <color name="ui_background">#F3F6F8</color>
    <color name="ui_surface">#FFFFFF</color>
    <color name="ui_text">#172B36</color>
    <color name="ui_muted">#647985</color>
    <color name="ui_border">#E1E9ED</color>
    <color name="ui_accent">#DDF3EE</color>
    <color name="ui_hero">#075E54</color>
    <color name="ui_hero_secondary">#BCE8DB</color>
    <style name="Stock.Title" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">26sp</item><item name="android:textColor">@color/ui_text</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Stock.Subtitle" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">14sp</item><item name="android:textColor">@color/ui_muted</item><item name="android:lineSpacingExtra">3dp</item></style>
    <style name="Stock.Card" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="cardCornerRadius">20dp</item><item name="cardElevation">0dp</item><item name="cardBackgroundColor">@color/ui_surface</item><item name="strokeColor">@color/ui_border</item><item name="strokeWidth">1dp</item></style>
    <style name="Stock.Button" parent="Widget.Material3.Button"><item name="cornerRadius">14dp</item><item name="android:textAllCaps">false</item><item name="android:minHeight">52dp</item><item name="android:textSize">14sp</item></style>
    <style name="Stock.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox"><item name="boxCornerRadiusTopStart">14dp</item><item name="boxCornerRadiusTopEnd">14dp</item><item name="boxCornerRadiusBottomStart">14dp</item><item name="boxCornerRadiusBottomEnd">14dp</item><item name="boxBackgroundColor">@color/ui_surface</item></style>
    <style name="Stock.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator"><item name="android:color">@color/ui_accent</item></style>
<color name="ui_on_primary">#FFFFFF</color></resources>
