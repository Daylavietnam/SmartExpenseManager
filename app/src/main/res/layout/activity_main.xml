<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background">
    <include layout="@layout/layout_common_ui"/>
    <androidx.core.widget.NestedScrollView android:id="@+id/nsv_main" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingBottom="76dp" app:layout_constraintTop_toBottomOf="@id/mtb_toolbar" app:layout_constraintBottom_toTopOf="@id/bnv_main" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Stock.Title" android:text="Tổng quan kho"/>
        <TextView style="@style/Stock.Subtitle" android:text="Hàng hóa trong tầm kiểm soát" android:layout_marginTop="4dp" android:layout_marginBottom="20dp"/>
        <com.google.android.material.card.MaterialCardView style="@style/Stock.Card" app:cardBackgroundColor="@color/ui_hero" app:strokeWidth="0dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/mtv_monthyear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tháng hiện tại" android:textColor="@color/ui_hero_secondary" android:textSize="13sp"/>
            <TextView android:id="@+id/mtv_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0đ" android:textSize="36sp" android:fontFamily="sans-serif-medium" android:textColor="@android:color/white" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/mtv_total_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tồn kho (giá tham chiếu):" android:textSize="13sp" android:textColor="@color/ui_hero_secondary" android:layout_marginTop="6dp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_marginBottom="12dp">
          <com.google.android.material.card.MaterialCardView style="@style/Stock.Card" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
              <TextView style="@style/Stock.Subtitle" android:text="↙  Nhập tháng này" android:textColor="@color/income_green"/>
              <TextView android:id="@+id/mtv_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0đ" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ui_text" android:layout_marginTop="8dp"/>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
          <com.google.android.material.card.MaterialCardView style="@style/Stock.Card" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
              <TextView style="@style/Stock.Subtitle" android:text="↗  Xuất tháng này" android:textColor="@color/expense_red"/>
              <TextView android:id="@+id/mtv_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0đ" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ui_text" android:layout_marginTop="8dp"/>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_budget" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"><com.google.android.material.textfield.TextInputEditText android:id="@+id/tiet_budget" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.card.MaterialCardView android:id="@+id/mcv_budget_container" style="@style/Stock.Card" android:layout_marginTop="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tình trạng hàng hóa" android:textSize="17sp" android:textColor="@color/ui_text" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/mtv_budget_info" style="@style/Stock.Subtitle" android:layout_marginTop="10dp"/>
            <TextView android:id="@+id/mtv_budget_remaining" style="@style/Stock.Subtitle" android:textColor="@color/ui_primary" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/mtv_budget_warning" style="@style/Stock.Subtitle" android:layout_marginTop="12dp"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/lpi_budget" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhịp hoạt động trong tháng" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ui_text" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
        <com.google.android.material.card.MaterialCardView style="@style/Stock.Card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/Stock.Subtitle" android:text="PHÂN TÍCH NHẬP KHO" android:textColor="@color/ui_primary" android:textSize="12sp" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/mtv_ai_income_placeholder" style="@style/Stock.Subtitle" android:text="Chưa có dữ liệu" android:layout_marginTop="12dp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Stock.Card" android:layout_marginTop="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/Stock.Subtitle" android:text="PHÂN TÍCH XUẤT KHO" android:textColor="@color/expense_red" android:textSize="12sp" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/mtv_ai_expense_placeholder" style="@style/Stock.Subtitle" android:text="Chưa có dữ liệu" android:layout_marginTop="12dp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/layoutLockScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_secure"
            app:tint="?attr/colorPrimary" />


        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ứng dụng đã bị khóa"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPin"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtLoginPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập mã PIN"
                android:inputType="numberPassword"
                android:maxLength="4"/>


        </com.google.android.material.textfield.TextInputLayout>



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mở khóa"/>


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>