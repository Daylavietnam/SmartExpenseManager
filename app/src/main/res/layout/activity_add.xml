<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background">
 <include layout="@layout/layout_common_ui"/>
 <androidx.core.widget.NestedScrollView android:id="@+id/nsv_main" android:layout_width="0dp" android:layout_height="0dp" android:paddingBottom="76dp" android:clipToPadding="false" app:layout_constraintTop_toBottomOf="@id/mtb_toolbar" app:layout_constraintBottom_toTopOf="@id/bnv_main" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
   <TextView style="@style/Stock.Title" android:text="Tạo phiếu kho"/>
   <TextView style="@style/Stock.Subtitle" android:text="Một phiếu, nhiều sản phẩm và một đối tác" android:layout_marginTop="4dp" android:layout_marginBottom="20dp"/>
   <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/mbtg_transaction_type" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
    <com.google.android.material.button.MaterialButton android:id="@+id/mbtn_income" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="↙  Nhập kho" android:textColor="@color/ui_text"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/mbtn_expense" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="↗  Xuất kho" android:textColor="@color/ui_text"/>
   </com.google.android.material.button.MaterialButtonToggleGroup>
   <LinearLayout android:id="@+id/stock_document_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
   <TextView android:id="@+id/mtv_date" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/bg_stock_field" android:gravity="center_vertical" android:text="Chọn ngày phiếu kho" android:textColor="@color/ui_text" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
   <com.google.android.material.chip.ChipGroup android:id="@+id/cg_categories" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" android:visibility="gone"/>
   <TextView style="@style/Stock.Subtitle" android:text="Số lượng tồn sẽ được cập nhật khi lưu phiếu." android:layout_marginTop="20dp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/mbtn_save" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:text="Lưu phiếu kho"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/mbtn_clear" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Xóa nội dung"/>
  </LinearLayout>
 </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>