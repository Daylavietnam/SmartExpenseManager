<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/ui_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView style="@style/Stock.Title" android:layout_marginTop="24dp" android:text="Cài đặt" />
  <TextView style="@style/Stock.Subtitle" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="Bảo mật và dữ liệu kho của bạn" />
  <com.google.android.material.card.MaterialCardView android:id="@+id/cardSettings" style="@style/Stock.Card">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView style="@style/Stock.Subtitle" android:text="BẢO MẬT" android:textColor="@color/ui_primary" android:letterSpacing="0.08" />
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchPin" android:layout_width="match_parent" android:layout_height="72dp" android:text="Đăng nhập bằng mã PIN" android:textSize="16sp" android:textColor="@color/ui_text" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_border" />
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchFingerprint" android:layout_width="match_parent" android:layout_height="72dp" android:text="Đăng nhập bằng vân tay" android:textSize="16sp" android:textColor="@color/ui_text" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView style="@style/Stock.Card" android:layout_marginTop="16dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView style="@style/Stock.Subtitle" android:text="DỮ LIỆU" android:textColor="@color/ui_primary" android:letterSpacing="0.08" />
    <TextView style="@style/Stock.Subtitle" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:text="Xuất danh sách sản phẩm và phiếu kho để lưu trữ hoặc chia sẻ." />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnExportCsv" style="@style/Stock.Button" android:layout_width="match_parent" android:layout_height="56dp" android:text="Xuất dữ liệu kho" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp">
   <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Hủy" android:textAllCaps="false" />
   <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" style="@style/Stock.Button" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Lưu cài đặt" />
  </LinearLayout>
 </LinearLayout>
</ScrollView>